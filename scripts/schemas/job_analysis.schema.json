{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "JobAnalysis",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "job_id",
    "requirements",
    "expected_outcomes",
    "leadership_mandate",
    "industry_knowledge",
    "culture_and_work_pattern_indicators"
  ],
  "properties": {
    "job_id": { "type": "string" },
    "requirements": {
      "type": "array",
      "minItems": 6,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "requirement_id",
          "requirement_label",
          "category",
          "source_text",
          "mandatory",
          "importance_components"
        ],
        "properties": {
          "requirement_id": { "type": "string" },
          "requirement_label": { "type": "string" },
          "category": { "type": "string" },
          "source_text": {
            "type": "array",
            "items": { "type": "string" }
          },
          "mandatory": { "type": "boolean" },
          "importance_components": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "role_mandate",
              "prominence",
              "business_outcome",
              "seniority",
              "repetition"
            ],
            "properties": {
              "role_mandate": { "type": "number", "minimum": 0, "maximum": 35 },
              "prominence": { "type": "number", "minimum": 0, "maximum": 20 },
              "business_outcome": { "type": "number", "minimum": 0, "maximum": 20 },
              "seniority": { "type": "number", "minimum": 0, "maximum": 15 },
              "repetition": { "type": "number", "minimum": 0, "maximum": 10 }
            }
          }
        }
      }
    },
    "expected_outcomes": { "type": "array", "items": { "type": "string" } },
    "leadership_mandate": { "type": "string" },
    "industry_knowledge": { "type": "array", "items": { "type": "string" } },
    "culture_and_work_pattern_indicators": { "type": "array", "items": { "type": "string" } }
  }
}
