{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TailoredExecutiveCV",
  "type": "object",
  "additionalProperties": false,
  "required": ["metadata", "strategy", "cv", "validation"],
  "properties": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "job_id",
        "target_title",
        "target_company",
        "profile_version",
        "document_variant",
        "page_target"
      ],
      "properties": {
        "schema_version": { "type": "string" },
        "job_id": { "type": "string" },
        "job_version_id": { "type": "string" },
        "target_title": { "type": "string" },
        "target_company": { "type": "string" },
        "profile_version": { "type": "string" },
        "document_variant": { "enum": ["ats_application", "executive_search"] },
        "page_target": { "type": "integer", "minimum": 2, "maximum": 3 },
        "output_basename": { "type": "string" }
      }
    },
    "strategy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "positioning_statement",
        "leadership_themes",
        "signature_fact_ids",
        "keyword_plan",
        "prohibited_claims"
      ],
      "properties": {
        "positioning_statement": { "type": "string" },
        "leadership_themes": {
          "type": "array",
          "minItems": 2,
          "maxItems": 4,
          "items": { "type": "string" }
        },
        "signature_fact_ids": {
          "type": "array",
          "minItems": 3,
          "maxItems": 5,
          "items": { "type": "string" }
        },
        "keyword_plan": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["term", "profile_fact_ids"],
            "properties": {
              "term": { "type": "string" },
              "profile_fact_ids": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          }
        },
        "prohibited_claims": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "cv": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contact",
        "headline",
        "executive_summary",
        "core_expertise",
        "role_alignment_snapshot",
        "experience",
        "education"
      ],
      "properties": {
        "contact": {
          "type": "object",
          "additionalProperties": false,
          "required": ["full_name", "location", "email", "phone"],
          "properties": {
            "full_name": { "type": "string" },
            "location": { "type": "string" },
            "email": { "type": "string", "format": "email" },
            "phone": { "type": "string" },
            "linkedin": { "type": "string" },
            "work_authorisation": { "type": "string" }
          }
        },
        "headline": { "type": "string" },
        "executive_summary": { "type": "string" },
        "core_expertise": {
          "type": "array",
          "minItems": 8,
          "maxItems": 14,
          "uniqueItems": true,
          "items": { "type": "string" }
        },
        "role_alignment_snapshot": {
          "type": "object",
          "additionalProperties": false,
          "required": ["heading", "target_role", "items"],
          "properties": {
            "heading": { "const": "Role Alignment Snapshot" },
            "target_role": { "type": "string" },
            "target_company": { "type": "string" },
            "items": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "requirement_id",
                  "requirement_label",
                  "evidence_statement",
                  "profile_fact_ids"
                ],
                "properties": {
                  "requirement_id": { "type": "string" },
                  "requirement_label": { "type": "string" },
                  "display_match_label": {
                    "enum": [
                      "Demonstrated at scale",
                      "Direct evidence",
                      "Transferable evidence"
                    ]
                  },
                  "evidence_statement": { "type": "string", "minLength": 40, "maxLength": 280 },
                  "profile_fact_ids": {
                    "type": "array",
                    "minItems": 1,
                    "items": { "type": "string" }
                  },
                  "keywords_used": {
                    "type": "array",
                    "items": { "type": "string" }
                  }
                }
              }
            }
          }
        },
        "experience": {
          "type": "array",
          "items": { "$ref": "#/$defs/experienceEntry" }
        },
        "earlier_career": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["employer", "title", "date_display"],
            "properties": {
              "employer": { "type": "string" },
              "title": { "type": "string" },
              "date_display": { "type": "string" },
              "relevance_line": { "type": "string" }
            }
          }
        },
        "selected_ventures_and_research": {
          "type": "array",
          "items": { "$ref": "#/$defs/experienceEntry" }
        },
        "education": {
          "type": "array",
          "items": { "type": "string" }
        },
        "certifications": {
          "type": "array",
          "items": { "type": "string" }
        },
        "languages": {
          "type": "array",
          "items": { "type": "string" }
        },
        "board_and_advisory": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unsupported_claims",
        "grounding_coverage_percentage",
        "chronology_issues",
        "requirement_coverage",
        "human_review_questions"
      ],
      "properties": {
        "unsupported_claims": {
          "type": "array",
          "maxItems": 0,
          "items": { "type": "string" }
        },
        "grounding_coverage_percentage": { "const": 100 },
        "chronology_issues": {
          "type": "array",
          "items": { "type": "string" }
        },
        "requirement_coverage": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["requirement_id", "status"],
            "properties": {
              "requirement_id": { "type": "string" },
              "status": {
                "enum": [
                  "covered",
                  "partially_covered",
                  "intentionally_omitted",
                  "gap"
                ]
              }
            }
          }
        },
        "human_review_questions": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "groundedBullet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "profile_fact_ids", "requirement_ids"],
      "properties": {
        "text": { "type": "string" },
        "profile_fact_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "requirement_ids": {
          "type": "array",
          "items": { "type": "string" }
        },
        "keywords_used": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "experienceEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role_id",
        "employer",
        "title",
        "date_display",
        "achievements"
      ],
      "properties": {
        "role_id": { "type": "string" },
        "employer": { "type": "string" },
        "employer_context": { "type": "string" },
        "title": { "type": "string" },
        "location": { "type": "string" },
        "date_display": { "type": "string" },
        "scope_statement": { "type": "string" },
        "achievements": {
          "type": "array",
          "items": { "$ref": "#/$defs/groundedBullet" }
        }
      }
    }
  }
}
