{
  "name": "job-decision-engine-cron",
  "private": true,
  "version": "1.0.0",
  "description": "Local desktop console and decision pipeline for grounded job ranking.",
  "author": "Elena Okhonko",
  "type": "module",
  "main": "desktop/electron/main.cjs",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "desktop:web": "npm run dev",
    "desktop:dev": "npm run build && electron .",
    "desktop:build": "npm run desktop:pack",
    "desktop:pack": "tsx scripts/package_desktop.ts --dir",
    "desktop:dist": "tsx scripts/package_desktop.ts --installer",
    "desktop:assets": "tsx scripts/prepare_desktop_assets.ts",
    "desktop:release:validate": "tsx scripts/validate_desktop_release.ts",
    "desktop:release:evidence": "tsx scripts/desktop_release_evidence.ts",
    "desktop:verify": "tsx scripts/verify_desktop_packaging.ts",
    "dev:setup": "tsx scripts/dev_setup.ts",
    "db:init": "tsx scripts/db_init.ts",
    "eval:run": "tsx scripts/evaluate_jobs.ts",
    "profile:import": "tsx scripts/import_profile.ts",
    "docs:cv": "tsx scripts/generate_cv.ts",
    "docs:cover-letter": "tsx scripts/generate_cover_letter.ts",
    "docs:compliance": "tsx scripts/generate_source_compliance_matrix.ts",
    "cutover:audit": "tsx scripts/backfill_cutover.ts",
    "backfill:v22": "tsx scripts/v22_backfill.ts",
    "api:v2": "tsx scripts/start_api_v2.ts",
    "test:streamlit": "tsx scripts/streamlit_e2e.ts",
    "contracts:export": "tsx scripts/export_contracts.ts",
    "contracts:check": "npm run contracts:export && git diff --exit-code -- src/contracts/json",
    "sources:sync": "tsx scripts/load_source_plugins.ts",
    "pipeline:worker": "tsx scripts/process_pipeline_tasks.ts",
    "decisions:replay": "tsx scripts/replay_deterministic_decisions.ts",
    "test": "vitest run",
    "eval:golden": "tsx scripts/run_evals.ts",
    "lint": "tsc --noEmit",
    "gemini:models": "tsx scripts/list_gemini_models.ts"
  },
  "build": {
    "appId": "com.jobdecisionengine.desktop",
    "productName": "Job Decision Engine",
    "artifactName": "Job-Decision-Engine-Setup-${version}.${ext}",
    "directories": {
      "output": "release"
    },
    "icon": "build/desktop/icon.png",
    "files": [
      "dist/**/*",
      "desktop/electron/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "desktop/electron/main.cjs"
    },
    "asar": true,
    "generateUpdatesFilesForAllChannels": true,
    "win": {
      "icon": "build/desktop/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "elenaokhonko-eng",
        "repo": "Job-Decision-Engine"
      }
    ]
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@types/express": "^5.0.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.0.5",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "docx": "^9.7.1",
    "dotenv": "^17.2.3",
    "electron-updater": "^6.8.9",
    "express": "^5.2.1",
    "fast-xml-parser": "^5.11.1",
    "imapflow": "^1.7.8",
    "openai": "^4.30.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.11.5",
    "playwright": "^1.62.1",
    "puppeteer": "^25.10.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.4.1",
    "@types/pg": "^8.11.5",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "js-yaml": "^5.2.1",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vitest": "^5.0.0"
  }
}
