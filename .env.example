# Core runtime
# Local dev (Docker Compose):
# DATABASE_URL="postgresql://jdec:jdec_password@localhost:5432/jdec?sslmode=disable"
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
# Direct/unpooled URL for migration and advisory-lock runners. Do not use a
# Neon -pooler hostname here. GitHub Actions stores this separately from the
# pooled runtime DATABASE_URL.
DATABASE_URL_UNPOOLED="postgresql://user:password@direct-host:5432/dbname?sslmode=require"
# Guardrail: `npm run dev:setup` refuses to run migrations against remote DATABASE_URL unless explicitly allowed.
ALLOW_DEV_SETUP_REMOTE_DB=""

# API v2 / workspace auth (used by src/api/v2 and Streamlit)
# In production, JDEC_API_TOKEN is required to access /api/v2 (Bearer auth).
JDEC_API_TOKEN=""
# Local development binds to loopback; managed deployments should set
# API_HOST="0.0.0.0" and terminate TLS at the hosting platform.
API_HOST="127.0.0.1"
# Legacy /api/* endpoints (unscoped) are disabled by default in production.
# Set ALLOW_LEGACY_API="true" to re-enable.
ALLOW_LEGACY_API=""
# Workspace scoping headers default to these env vars if not provided per request.
WORKSPACE_KEY="default"
WORKSPACE_USER_KEY="local_user"
# Streamlit can point at a remote backend by overriding the base URL.
JDEC_API_BASE_URL="http://localhost:3000"

# Primary and fallback provider credentials
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_FLASH_API_KEY=""
OPENAI_API_KEY="YOUR_OPENAI_KEY"

# Optional Gemini API version override (AI Studio only; useful when model IDs differ by API version)
# Examples: "v1beta", "v1", "v1alpha"
GEMINI_API_VERSION="v1beta"

# Gemini backend: "studio" (default, AI Studio API key above) or "vertex" (Vertex AI).
# Vertex authenticates with Application Default Credentials: locally a service-account key file
# in GOOGLE_APPLICATION_CREDENTIALS (or `gcloud auth application-default login`); in GitHub
# Actions Workload Identity Federation (repository variables GCP_WORKLOAD_IDENTITY_PROVIDER and
# GCP_SERVICE_ACCOUNT). No AI Studio key is needed or used in vertex mode.
GEMINI_BACKEND="studio"
GOOGLE_CLOUD_PROJECT=""
# Vertex location. "global" is the default and the recommended value: the global endpoint draws
# on Google's capacity across regions (fewer 429s than a single region's shared quota), new Gemini
# models appear there first, and Flex PayGo is only offered there. A single region (for example
# "us-central1") is refused unless GEMINI_ALLOW_REGIONAL_LOCATION="true" is also set, so a data
# residency choice is always deliberate.
GOOGLE_CLOUD_LOCATION="global"
# GEMINI_ALLOW_REGIONAL_LOCATION="false"
# GOOGLE_APPLICATION_CREDENTIALS="/path/to/service-account.json"
# Optional AI Studio key used only by manual CV summary / cover-letter generation (studio mode), so
# the laptop and the scheduled pipeline can draw on different Google projects' quotas.
# DOCUMENT_GEMINI_API_KEY=""
# Vertex only: send pipeline extraction and evaluation as Flex PayGo (cheaper, slower, global
# endpoint only). Never applied to interactive document calls.
# GEMINI_PIPELINE_FLEX="false"

# Rate limits and deadlines for model calls. A 429 is retried with exponential backoff and full
# jitter (1 s base, x2, 32 s cap; RetryInfo / Retry-After win when present), up to
# GEMINI_RATE_LIMIT_MAX_ATTEMPTS per model, never past the per-call deadline. Interactive document
# calls switch to the secondary Gemini model on the first 429.
# GEMINI_RATE_LIMIT_MAX_ATTEMPTS="5"
# MODEL_BACKOFF_BASE_MS="1000"
# MODEL_BACKOFF_CAP_MS="32000"
# MODEL_INTERACTIVE_CALL_DEADLINE_MS="60000"
# MODEL_PIPELINE_CALL_DEADLINE_MS="300000"
# Process-wide limiter per model. GEMINI_MAX_REQUESTS_PER_MINUTE is the default for every model;
# GEMINI_MODEL_LIMITS_JSON overrides per model, e.g. {"gemini-3.8-flash":{"rpm":30,"tpm":500000,"concurrency":2}}
# GEMINI_MAX_REQUESTS_PER_MINUTE="60"
# GEMINI_MAX_TOKENS_PER_MINUTE="1000000"
# GEMINI_MAX_CONCURRENCY="4"
# GEMINI_MODEL_LIMITS_JSON=""
# Inputs per embedContent request (AI Studio default 100; Vertex default 1, the documented limit
# for gemini-embedding-001 there).
# EMBEDDING_GEMINI_BATCH_SIZE=""
# Manual document generation job deadline (summary + letter + files); a job left RUNNING past it
# (for example after an API restart) is reported as interrupted and can be started again.
# MANUAL_DOCUMENT_JOB_DEADLINE_MS="300000"
# Status report: how far back provider calls are counted for the 429 stop rule.
# PIPELINE_PROVIDER_CALL_WINDOW_MINUTES="90"

# Model routing registry (used by preflight + runtime)
EVALUATION_PRIMARY_MODEL="gemini-3.6-flash"
EVALUATION_FALLBACK_MODEL="gpt-4o-mini"
EMBEDDING_PRIMARY_MODEL="gemini-embedding-001"
EMBEDDING_FALLBACK_MODEL="text-embedding-3-small"
EMBEDDING_PRIMARY_DIMENSIONS="768"
EMBEDDING_FALLBACK_DIMENSIONS="1536"
# Concurrent embedding provider requests per batch (default 4, max 16; 1 = sequential). Each
# request carries up to EMBEDDING_GEMINI_BATCH_SIZE inputs (OpenAI: 100); Gemini requests also
# pass the process-wide per-model limiter shared by all worker lanes.
EMBEDDING_PROVIDER_CONCURRENCY="4"
# Pipeline tasks processed at once by scripts/process_pipeline_tasks.ts (1-16, default 1 = sequential).
# Each lane uses its own database connection; NORMALIZE_OBSERVATION, PUBLISH_EMBEDDING and
# ENQUEUE_EXPLANATION still run one task at a time.
PIPELINE_TASK_WORKER_CONCURRENCY="1"
DOCUMENT_PRIMARY_MODEL="gemini-3.8-flash"
DOCUMENT_FALLBACK_MODEL="gpt-4o-mini"
REQUIREMENTS_OPENAI_MODEL="gpt-5.6-luna"
REQUIREMENTS_GEMINI_MODEL="gemini-3.1-flash-lite"
MODEL_REQUEST_MAX_RETRIES="3"
MODEL_REQUEST_TIMEOUT_MS="60000"
# Manual CV summary / cover letter: per-request timeouts (ms, 5000..300000; the 60 s interactive
# call deadline still caps each section) and the Gemini model switched to after a 429 or failure on
# the document model, before OpenAI.
# MANUAL_SUMMARY_TIMEOUT_MS="45000"
# MANUAL_COVER_LETTER_TIMEOUT_MS="90000"
DOCUMENT_SECONDARY_GEMINI_MODEL="gemini-3.1-flash-lite"
REQUIREMENTS_DB_STATEMENT_TIMEOUT_MS="60000"

# Explicit provider preference (optional)
# Allowed values: "gemini" | "openai"
EVALUATION_PRIMARY_PROVIDER="gemini"
DOCUMENT_PRIMARY_PROVIDER="gemini"
REQUIREMENTS_PRIMARY_PROVIDER="openai"
EMBEDDING_PRIMARY_PROVIDER="gemini"
EMBEDDING_FALLBACK_PROVIDER="openai"

# Comprehensive quoted requirement extraction is enabled in the production workflow.
# Set REQUIREMENTS_PRIMARY_PROVIDER="gemini" to try the Flash/Lite route first.
REQUIREMENTS_ENABLE_QUOTED="true"

# Legacy compatibility aliases (optional). GEMINI_MODEL still feeds EVALUATION_PRIMARY_MODEL when
# that is unset; document generation no longer reads it (set DOCUMENT_PRIMARY_MODEL instead).
GEMINI_MODEL="gemini-3.6-flash"
OPENAI_MODEL="gpt-4o-mini"

# Gmail API ingestion (OAuth 2.0 refresh token; requests use HTTPS/443)
GMAIL_OAUTH_CLIENT_ID="your-google-oauth-client-id"
GMAIL_OAUTH_CLIENT_SECRET="your-google-oauth-client-secret"
GMAIL_OAUTH_REFRESH_TOKEN="your-google-oauth-refresh-token"
GMAIL_FOLDER="Jobs-Alerts"
GMAIL_PROCESSED_FOLDER="Jobs-Alerts-Processed"
GMAIL_READ_ONLY="false"
GMAIL_MAX_MESSAGES_PER_RUN="250"
GMAIL_PACING_DELAY_MS="25"

# LinkedIn jobs through SearchAPI (searchapi.io): discovery search + full job details, and
# full descriptions for LinkedIn links found in email alerts. Off unless ENABLED is "true".
# Every call spends one credit; the daily cap is enforced in Postgres (searchapi_credit_days).
SEARCHAPI_LINKEDIN_ENABLED="false"
SEARCHAPI_API_KEY="your-searchapi-key"
SEARCHAPI_DAILY_CREDIT_CAP="60"
GMAIL_INGEST_MAX_ATTEMPTS="3"

