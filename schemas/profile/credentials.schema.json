{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Profile Credentials",
  "description": "Certifications, degrees, course completions, licenses",
  "type": "object",
  "required": ["schema_version", "profile_key", "credentials"],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$"
    },
    "profile_key": {
      "type": "string",
      "pattern": "^[a-z_][a-z0-9_]{0,63}$"
    },
    "credentials": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "credential_key",
          "credential_name",
          "issuer",
          "credential_type",
          "status",
          "verification_status"
        ],
        "properties": {
          "credential_key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.]{1,127}$"
          },
          "credential_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "issuer": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "credential_type": {
            "type": "string",
            "enum": ["CERTIFICATION", "DEGREE", "COURSE", "LICENSE"]
          },
          "level": {
            "type": ["string", "null"],
            "examples": ["FOUNDATIONAL", "ASSOCIATE", "PROFESSIONAL", "EXPERT", "BACHELOR", "MASTER", "PHD"]
          },
          "issued_on": {
            "type": ["string", "null"],
            "format": "date"
          },
          "expires_on": {
            "type": ["string", "null"],
            "format": "date"
          },
          "status": {
            "type": "string",
            "enum": ["ACTIVE", "EXPIRED", "IN_PROGRESS", "REVOKED"]
          },
          "verification_status": {
            "type": "string",
            "enum": ["VERIFIED", "SELF_ATTESTED", "UNVERIFIED"]
          },
          "evidence_source_key": {
            "type": ["string", "null"]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
