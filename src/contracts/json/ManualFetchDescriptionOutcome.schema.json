{
  "$ref": "#/definitions/ManualFetchDescriptionOutcome",
  "definitions": {
    "ManualFetchDescriptionOutcome": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "COMPLETE"
            },
            "posting": {
              "type": "object",
              "properties": {
                "schema_version": {
                  "type": "string",
                  "const": "manual_application_v1"
                },
                "ok": {
                  "type": "boolean",
                  "const": true
                },
                "fetch_receipt_id": {
                  "type": "string",
                  "format": "uuid"
                },
                "description": {
                  "type": "string",
                  "minLength": 100,
                  "maxLength": 100000
                },
                "final_url": {
                  "type": "string",
                  "format": "uri",
                  "maxLength": 2048
                },
                "provider": {
                  "type": "string",
                  "enum": [
                    "ASHBY",
                    "GREENHOUSE",
                    "LEVER",
                    "EMPLOYER_WEBSITE"
                  ]
                },
                "content_hash": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "source_evidence": {
                  "type": "object",
                  "properties": {
                    "requestedUrl": {
                      "$ref": "#/definitions/ManualFetchDescriptionOutcome/anyOf/0/properties/posting/properties/final_url"
                    },
                    "resolvedUrl": {
                      "$ref": "#/definitions/ManualFetchDescriptionOutcome/anyOf/0/properties/posting/properties/final_url"
                    },
                    "redirectHistory": {
                      "type": "array",
                      "items": {
                        "$ref": "#/definitions/ManualFetchDescriptionOutcome/anyOf/0/properties/posting/properties/final_url"
                      },
                      "maxItems": 5
                    },
                    "retrievedAt": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "httpStatus": {
                      "type": "integer",
                      "minimum": 100,
                      "maximum": 599
                    },
                    "contentType": {
                      "anyOf": [
                        {
                          "type": "string",
                          "maxLength": 255
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "responseHash": {
                      "$ref": "#/definitions/ManualFetchDescriptionOutcome/anyOf/0/properties/posting/properties/content_hash"
                    }
                  },
                  "required": [
                    "requestedUrl",
                    "resolvedUrl",
                    "redirectHistory",
                    "retrievedAt",
                    "httpStatus",
                    "contentType",
                    "responseHash"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "schema_version",
                "ok",
                "fetch_receipt_id",
                "description",
                "final_url",
                "provider",
                "content_hash",
                "source_evidence"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "status",
            "posting"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "RETRYABLE_FAILURE",
                "BLOCKED",
                "IDENTITY_CONFLICT",
                "UNAVAILABLE"
              ]
            },
            "code": {
              "type": "string",
              "minLength": 1
            },
            "message": {
              "type": "string",
              "minLength": 1
            },
            "retry_after_ms": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "status",
            "code",
            "message"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}