{
  "$ref": "#/definitions/ArchiveRunReport",
  "definitions": {
    "ArchiveRunReport": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "job_archive_v1"
        },
        "run_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "mode": {
          "type": "string",
          "enum": [
            "DRY_RUN",
            "APPLY"
          ]
        },
        "rule": {
          "type": "string",
          "enum": [
            "age",
            "hard-rejected",
            "all"
          ]
        },
        "workspace_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "run_status": {
          "type": "string",
          "enum": [
            "DRY_RUN",
            "RUNNING",
            "SUCCEEDED",
            "FAILED"
          ]
        },
        "completed_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "archive_schema_ready": {
          "type": "boolean"
        },
        "run_started_at": {
          "type": "string",
          "format": "date-time"
        },
        "cutoff_at": {
          "type": "string",
          "format": "date-time"
        },
        "scanned_count": {
          "type": "integer",
          "minimum": 0
        },
        "eligible_count": {
          "type": "integer",
          "minimum": 0
        },
        "archived_count": {
          "type": "integer",
          "minimum": 0
        },
        "protected_count": {
          "type": "integer",
          "minimum": 0
        },
        "invalid_date_count": {
          "type": "integer",
          "minimum": 0
        },
        "failed_count": {
          "type": "integer",
          "minimum": 0
        },
        "deferred_count": {
          "type": "integer",
          "minimum": 0
        },
        "observed_age_publication_unknown_count": {
          "type": "integer",
          "minimum": 0
        },
        "candidates": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "canonical_job_id": {
                "type": "string",
                "format": "uuid"
              },
              "workspace_id": {
                "type": "string",
                "format": "uuid"
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "company": {
                "type": "string",
                "minLength": 1
              },
              "reference_at": {
                "type": "string",
                "format": "date-time"
              },
              "age_basis": {
                "type": "string",
                "enum": [
                  "GENUINE_REPOST_DATE",
                  "AUTHORITATIVE_PUBLICATION_DATE",
                  "OBSERVED_AGE_PUBLICATION_UNKNOWN"
                ]
              },
              "archive_reason": {
                "type": "string",
                "const": "JOB_OLDER_THAN_THREE_CALENDAR_MONTHS"
              },
              "publication_date_unknown": {
                "type": "boolean"
              }
            },
            "required": [
              "canonical_job_id",
              "workspace_id",
              "title",
              "company",
              "reference_at",
              "age_basis",
              "archive_reason",
              "publication_date_unknown"
            ],
            "additionalProperties": false
          }
        },
        "invalid_date_jobs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "canonical_job_id": {
                "type": "string",
                "format": "uuid"
              },
              "reason_code": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "canonical_job_id",
              "reason_code"
            ],
            "additionalProperties": false
          }
        },
        "failed_jobs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "canonical_job_id": {
                "type": "string",
                "format": "uuid"
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "canonical_job_id",
              "reason"
            ],
            "additionalProperties": false
          }
        },
        "hard_rejected": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "scanned_count": {
              "type": "integer",
              "minimum": 0
            },
            "eligible_count": {
              "type": "integer",
              "minimum": 0
            },
            "archived_count": {
              "type": "integer",
              "minimum": 0
            },
            "protected_count": {
              "type": "integer",
              "minimum": 0
            },
            "excluded_saved_source_count": {
              "type": "integer",
              "minimum": 0
            },
            "missing_reason_codes_count": {
              "type": "integer",
              "minimum": 0
            },
            "unverifiable_decision_count": {
              "type": "integer",
              "minimum": 0
            },
            "reference_fallback_count": {
              "type": "integer",
              "minimum": 0
            },
            "failed_count": {
              "type": "integer",
              "minimum": 0
            },
            "deferred_count": {
              "type": "integer",
              "minimum": 0
            },
            "candidate_count": {
              "type": "integer",
              "minimum": 0
            },
            "candidates": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "canonical_job_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "workspace_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "reference_at": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "reference_source": {
                    "type": "string",
                    "enum": [
                      "GATE_DECISION",
                      "CANONICAL_UPDATED_AT_FALLBACK"
                    ]
                  },
                  "gate_decision_id": {
                    "anyOf": [
                      {
                        "type": "string",
                        "format": "uuid"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "rejection_codes": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "minItems": 1
                  },
                  "archive_reason": {
                    "type": "string",
                    "const": "HARD_REJECTED_PERMANENT"
                  }
                },
                "required": [
                  "canonical_job_id",
                  "workspace_id",
                  "reference_at",
                  "reference_source",
                  "gate_decision_id",
                  "rejection_codes",
                  "archive_reason"
                ],
                "additionalProperties": false
              }
            },
            "failed_jobs": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "canonical_job_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "canonical_job_id",
                  "reason"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "enabled",
            "scanned_count",
            "eligible_count",
            "archived_count",
            "protected_count",
            "excluded_saved_source_count",
            "missing_reason_codes_count",
            "unverifiable_decision_count",
            "reference_fallback_count",
            "failed_count",
            "deferred_count",
            "candidate_count",
            "candidates",
            "failed_jobs"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schema_version",
        "run_id",
        "mode",
        "rule",
        "workspace_id",
        "run_status",
        "completed_at",
        "archive_schema_ready",
        "run_started_at",
        "cutoff_at",
        "scanned_count",
        "eligible_count",
        "archived_count",
        "protected_count",
        "invalid_date_count",
        "failed_count",
        "deferred_count",
        "observed_age_publication_unknown_count",
        "candidates",
        "invalid_date_jobs",
        "failed_jobs",
        "hard_rejected"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}