{
  "$ref": "#/definitions/ManualDownloadResponse",
  "definitions": {
    "ManualDownloadResponse": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "manual_application_v1"
        },
        "ok": {
          "type": "boolean",
          "const": true
        },
        "filename": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "mime_type": {
          "type": "string",
          "enum": [
            "application/pdf",
            "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
          ]
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "content_base64": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "schema_version",
        "ok",
        "filename",
        "mime_type",
        "sha256",
        "content_base64"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}