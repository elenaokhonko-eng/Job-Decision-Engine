{
  "$ref": "#/definitions/ManualComparisonSource",
  "definitions": {
    "ManualComparisonSource": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "source_kind": {
              "type": "string",
              "enum": [
                "PASTED",
                "UPLOAD"
              ]
            },
            "source_content_status": {
              "type": "string",
              "const": "USER_PROVIDED"
            },
            "provider": {
              "type": "null"
            },
            "fetched_content_hash": {
              "type": "null"
            },
            "source_evidence": {
              "type": "null"
            }
          },
          "required": [
            "source_kind",
            "source_content_status",
            "provider",
            "fetched_content_hash",
            "source_evidence"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "source_kind": {
              "type": "string",
              "const": "FETCHED"
            },
            "source_content_status": {
              "type": "string",
              "enum": [
                "COMPLETE",
                "USER_EDITED"
              ]
            },
            "provider": {
              "type": "string",
              "enum": [
                "ASHBY",
                "GREENHOUSE",
                "LEVER",
                "EMPLOYER_WEBSITE"
              ]
            },
            "fetched_content_hash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "source_evidence": {
              "type": "object",
              "properties": {
                "requestedUrl": {
                  "type": "string",
                  "format": "uri",
                  "maxLength": 2048
                },
                "resolvedUrl": {
                  "$ref": "#/definitions/ManualComparisonSource/anyOf/1/properties/source_evidence/properties/requestedUrl"
                },
                "redirectHistory": {
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/ManualComparisonSource/anyOf/1/properties/source_evidence/properties/requestedUrl"
                  },
                  "maxItems": 5
                },
                "retrievedAt": {
                  "type": "string",
                  "format": "date-time"
                },
                "httpStatus": {
                  "type": "integer",
                  "minimum": 100,
                  "maximum": 599
                },
                "contentType": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 255
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "responseHash": {
                  "$ref": "#/definitions/ManualComparisonSource/anyOf/1/properties/fetched_content_hash"
                }
              },
              "required": [
                "requestedUrl",
                "resolvedUrl",
                "redirectHistory",
                "retrievedAt",
                "httpStatus",
                "contentType",
                "responseHash"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "source_kind",
            "source_content_status",
            "provider",
            "fetched_content_hash",
            "source_evidence"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}