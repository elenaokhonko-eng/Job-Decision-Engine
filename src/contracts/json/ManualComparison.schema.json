{
  "$ref": "#/definitions/ManualComparison",
  "definitions": {
    "ManualComparison": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "manual_application_v1"
        },
        "comparator_version": {
          "type": "string",
          "minLength": 1
        },
        "canonical_job_id": {
          "type": "string",
          "format": "uuid"
        },
        "job_version_id": {
          "$ref": "#/definitions/ManualComparison/properties/canonical_job_id"
        },
        "source_observation_id": {
          "$ref": "#/definitions/ManualComparison/properties/canonical_job_id"
        },
        "source_evidence_fingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "job_content_hash": {
          "type": "string",
          "minLength": 1
        },
        "profile_version_id": {
          "$ref": "#/definitions/ManualComparison/properties/canonical_job_id"
        },
        "candidate_profile_id": {
          "$ref": "#/definitions/ManualComparison/properties/canonical_job_id"
        },
        "requirement_set_id": {
          "$ref": "#/definitions/ManualComparison/properties/canonical_job_id"
        },
        "profile_contact_fact_ids": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ManualComparison/properties/canonical_job_id"
          }
        },
        "profile_contact_fingerprint": {
          "$ref": "#/definitions/ManualComparison/properties/source_evidence_fingerprint"
        },
        "preference_context_fingerprint": {
          "$ref": "#/definitions/ManualComparison/properties/source_evidence_fingerprint"
        },
        "context_fingerprint": {
          "$ref": "#/definitions/ManualComparison/properties/source_evidence_fingerprint"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "company": {
          "type": "string",
          "minLength": 1
        },
        "canonical_url": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri"
            },
            {
              "type": "null"
            }
          ]
        },
        "requirements": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "requirement_key": {
                "type": "string",
                "minLength": 1
              },
              "requirement_type": {
                "type": "string",
                "minLength": 1
              },
              "importance": {
                "type": "string",
                "enum": [
                  "MUST",
                  "PREFERRED",
                  "NICE_TO_HAVE"
                ]
              },
              "requirement_text": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "requirement_key",
              "requirement_type",
              "importance",
              "requirement_text"
            ],
            "additionalProperties": false
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "evidence_type": {
                "type": "string",
                "enum": [
                  "FACT",
                  "CREDENTIAL",
                  "ENGAGEMENT"
                ]
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "statement": {
                "type": "string",
                "minLength": 1
              },
              "engagement_id": {
                "type": "string",
                "minLength": 1
              },
              "fact_type": {
                "type": "string",
                "minLength": 1
              },
              "credential_type": {
                "type": "string",
                "enum": [
                  "CERTIFICATION",
                  "DEGREE",
                  "COURSE",
                  "LICENSE"
                ]
              },
              "engagement_type": {
                "type": "string",
                "enum": [
                  "EMPLOYEE",
                  "FOUNDER_OPERATOR",
                  "CONTRACTOR",
                  "RESEARCHER"
                ]
              },
              "experience_class": {
                "type": "string",
                "minLength": 1
              },
              "start_date": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "end_date": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "document_layout": {
                "type": "string",
                "enum": [
                  "FULL",
                  "ONE_LINE",
                  "HIDDEN"
                ]
              },
              "always_include": {
                "type": "boolean"
              },
              "cv_statement": {
                "type": "string",
                "minLength": 1,
                "maxLength": 400
              },
              "issuer": {
                "type": "string",
                "minLength": 1
              },
              "issued_on": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              }
            },
            "required": [
              "id",
              "evidence_type",
              "label",
              "statement"
            ],
            "additionalProperties": false
          }
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "requirement_key": {
                "type": "string",
                "minLength": 1
              },
              "requirement_type": {
                "type": "string",
                "minLength": 1
              },
              "importance": {
                "type": "string",
                "enum": [
                  "MUST",
                  "PREFERRED",
                  "NICE_TO_HAVE"
                ]
              },
              "requirement": {
                "type": "string",
                "minLength": 1
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "type": {
                      "type": "string",
                      "enum": [
                        "FACT",
                        "CREDENTIAL",
                        "ENGAGEMENT"
                      ]
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1
                    },
                    "statement": {
                      "type": "string",
                      "minLength": 1
                    },
                    "confidence": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "justification": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "id",
                    "type",
                    "label",
                    "statement"
                  ],
                  "additionalProperties": false
                }
              },
              "gap": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "comparison_method": {
                "type": "string",
                "enum": [
                  "literal-term overlap; potential evidence only",
                  "distinctive-term overlap; potential evidence only",
                  "model-judged pairing; advisory evidence only"
                ]
              },
              "attention": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "enum": [
                        "DOMAIN_QUALIFIER",
                        "YEARS_THRESHOLD",
                        "NAMED_CERTIFICATION"
                      ]
                    },
                    "detail": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "code",
                    "detail"
                  ],
                  "additionalProperties": false
                }
              },
              "suggested_status": {
                "type": "string",
                "const": "PARTIAL"
              }
            },
            "required": [
              "requirement_key",
              "requirement_type",
              "importance",
              "requirement",
              "evidence",
              "gap",
              "comparison_method"
            ],
            "additionalProperties": false
          }
        },
        "fit": {
          "type": "object",
          "properties": {
            "must_total": {
              "type": "integer",
              "minimum": 0
            },
            "must_covered": {
              "type": "integer",
              "minimum": 0
            },
            "uncovered_must": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "requirement_key": {
                    "type": "string",
                    "minLength": 1
                  },
                  "requirement": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "requirement_key",
                  "requirement"
                ],
                "additionalProperties": false
              }
            },
            "verdict": {
              "type": "string",
              "enum": [
                "NO_MUST_REQUIREMENTS",
                "MOST_MUSTS_EVIDENCED",
                "FEWER_THAN_HALF_MUSTS_EVIDENCED"
              ]
            },
            "message": {
              "type": "string",
              "minLength": 1
            },
            "advisory": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "must_total",
            "must_covered",
            "uncovered_must",
            "verdict",
            "message",
            "advisory"
          ],
          "additionalProperties": false
        },
        "suitability_warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence_notice": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "schema_version",
        "comparator_version",
        "canonical_job_id",
        "job_version_id",
        "source_observation_id",
        "source_evidence_fingerprint",
        "job_content_hash",
        "profile_version_id",
        "candidate_profile_id",
        "requirement_set_id",
        "profile_contact_fact_ids",
        "profile_contact_fingerprint",
        "preference_context_fingerprint",
        "context_fingerprint",
        "title",
        "company",
        "canonical_url",
        "requirements",
        "evidence",
        "rows",
        "suitability_warnings",
        "evidence_notice"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}