{
  "$ref": "#/definitions/ExtractedJob",
  "definitions": {
    "ExtractedJob": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "enum": [
            "2.2.0",
            "2.0",
            "1.0.0"
          ],
          "default": "2.2.0"
        },
        "source_external_id": {
          "type": "string",
          "minLength": 1
        },
        "company_name": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "location_raw": {
          "type": "string",
          "default": "Unknown"
        },
        "workplace_type_raw": {
          "type": "string",
          "default": "UNKNOWN"
        },
        "employment_type_raw": {
          "type": "string",
          "default": "UNKNOWN"
        },
        "compensation_raw": {
          "type": "string",
          "default": "UNKNOWN"
        },
        "canonical_apply_url": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri"
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        },
        "description_raw": {
          "type": "string",
          "minLength": 1
        },
        "published_at": {
          "type": "string",
          "format": "date-time"
        },
        "feed_delay_hours": {
          "type": "number",
          "minimum": 0
        },
        "source_attribution": {
          "type": "string",
          "minLength": 1
        },
        "raw_payload": {}
      },
      "required": [
        "company_name",
        "title",
        "canonical_apply_url",
        "description_raw"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}