{
  "$ref": "#/definitions/ManualDocumentsResponse",
  "definitions": {
    "ManualDocumentsResponse": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "manual_application_v1"
        },
        "ok": {
          "type": "boolean",
          "const": true
        },
        "draft_id": {
          "type": "string",
          "format": "uuid"
        },
        "approval_id": {
          "$ref": "#/definitions/ManualDocumentsResponse/properties/draft_id"
        },
        "comparison_fingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "preview": {
          "type": "object",
          "properties": {
            "cv": {
              "type": "string",
              "minLength": 1
            },
            "cover_letter": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "cv",
            "cover_letter"
          ],
          "additionalProperties": false
        },
        "artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "CV",
                  "COVER_LETTER"
                ]
              },
              "format": {
                "type": "string",
                "enum": [
                  "DOCX",
                  "PDF"
                ]
              },
              "filename": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "mime_type": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "type",
              "format",
              "filename",
              "mime_type"
            ],
            "additionalProperties": false
          },
          "minItems": 4,
          "maxItems": 4
        },
        "cover_letter": {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "AI_WRITTEN",
                "DETERMINISTIC"
              ]
            },
            "reason": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                },
                {
                  "type": "null"
                }
              ]
            },
            "sentences": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "text": {
                    "type": "string",
                    "minLength": 1
                  },
                  "evidence": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "label": {
                          "type": "string"
                        },
                        "statement": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "id",
                        "label",
                        "statement"
                      ],
                      "additionalProperties": false
                    },
                    "minItems": 1
                  },
                  "requirement_keys": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "required": [
                  "text",
                  "evidence",
                  "requirement_keys"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "mode",
            "reason",
            "sentences"
          ],
          "additionalProperties": false
        },
        "summary": {
          "$ref": "#/definitions/ManualDocumentsResponse/properties/cover_letter"
        }
      },
      "required": [
        "schema_version",
        "ok",
        "draft_id",
        "approval_id",
        "comparison_fingerprint",
        "preview",
        "artifacts"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}