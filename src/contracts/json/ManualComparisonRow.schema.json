{
  "$ref": "#/definitions/ManualComparisonRow",
  "definitions": {
    "ManualComparisonRow": {
      "type": "object",
      "properties": {
        "requirement_key": {
          "type": "string",
          "minLength": 1
        },
        "requirement_type": {
          "type": "string",
          "minLength": 1
        },
        "importance": {
          "type": "string",
          "enum": [
            "MUST",
            "PREFERRED",
            "NICE_TO_HAVE"
          ]
        },
        "requirement": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "type": "string",
                "enum": [
                  "FACT",
                  "CREDENTIAL",
                  "ENGAGEMENT"
                ]
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "statement": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "type",
              "label",
              "statement"
            ],
            "additionalProperties": false
          }
        },
        "gap": {
          "type": [
            "string",
            "null"
          ]
        },
        "comparison_method": {
          "type": "string",
          "const": "literal-term overlap; potential evidence only"
        }
      },
      "required": [
        "requirement_key",
        "requirement_type",
        "importance",
        "requirement",
        "evidence",
        "gap",
        "comparison_method"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}