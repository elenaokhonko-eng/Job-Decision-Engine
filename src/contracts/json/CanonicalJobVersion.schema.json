{
  "$ref": "#/definitions/CanonicalJobVersion",
  "definitions": {
    "CanonicalJobVersion": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "enum": [
            "2.2.0",
            "2.0",
            "1.0.0"
          ],
          "default": "2.2.0"
        },
        "canonical_job_id": {
          "type": "string",
          "format": "uuid"
        },
        "job_version_id": {
          "type": "string",
          "minLength": 1
        },
        "company_name": {
          "type": "string",
          "minLength": 1
        },
        "normalized_title": {
          "type": "string",
          "minLength": 1
        },
        "canonical_url": {
          "type": "string",
          "minLength": 1
        },
        "location_summary": {
          "type": "string",
          "default": "Unknown"
        },
        "workplace_type": {
          "type": "string",
          "enum": [
            "REMOTE",
            "HYBRID",
            "ONSITE",
            "UNKNOWN"
          ],
          "default": "UNKNOWN"
        },
        "employment_type": {
          "type": "string",
          "default": "UNKNOWN"
        },
        "description_text": {
          "type": "string",
          "minLength": 1
        },
        "version_number": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "default": 1
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "processing_state": {
          "type": "string",
          "enum": [
            "RAW_STAGED",
            "HARD_REJECTED",
            "MANUALLY_REMOVED",
            "NEEDS_VERIFICATION",
            "PREQUALIFIED",
            "ROUTING_DEFERRED",
            "LANE_ROUTED",
            "MATCHED",
            "SEMANTIC_SHORTLISTED",
            "QUEUED_FOR_AI",
            "EVALUATING",
            "AI_EVALUATED",
            "EVALUATED",
            "RETRY_WAIT",
            "NEEDS_MANUAL_REVIEW",
            "REJECTED_AFTER_EVALUATION"
          ],
          "default": "RAW_STAGED"
        },
        "processing_status": {
          "type": "string",
          "enum": [
            "RAW_STAGED",
            "HARD_REJECTED",
            "MANUALLY_REMOVED",
            "NEEDS_VERIFICATION",
            "PREQUALIFIED",
            "ROUTING_DEFERRED",
            "LANE_ROUTED",
            "MATCHED",
            "SEMANTIC_SHORTLISTED",
            "QUEUED_FOR_AI",
            "EVALUATING",
            "AI_EVALUATED",
            "EVALUATED",
            "RETRY_WAIT",
            "NEEDS_MANUAL_REVIEW",
            "REJECTED_AFTER_EVALUATION"
          ],
          "default": "RAW_STAGED"
        },
        "recommendation_eligibility": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "ELIGIBLE",
                "VERIFY",
                "INELIGIBLE"
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "recommendation_outcome": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "PRIORITY",
                "REVIEW",
                "TRACK",
                "SKIP"
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "recommendation_requirement_score": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "recommendation_coverage_score": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "recommendation_evidence_completeness": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "recommendation_decided_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "canonical_job_id",
        "job_version_id",
        "company_name",
        "normalized_title",
        "canonical_url",
        "description_text",
        "observed_at"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}