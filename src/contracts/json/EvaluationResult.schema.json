{
  "$ref": "#/definitions/EvaluationResult",
  "definitions": {
    "EvaluationResult": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "enum": [
            "2.2.0",
            "2.0",
            "1.0.0"
          ],
          "default": "2.2.0"
        },
        "canonical_job_id": {
          "type": "string",
          "format": "uuid"
        },
        "job_version_id": {
          "type": "string",
          "minLength": 1
        },
        "pipeline_run_id": {
          "type": "string",
          "format": "uuid"
        },
        "provider": {
          "type": "string",
          "enum": [
            "gemini",
            "openai",
            "local",
            "mock"
          ]
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "attempt": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "default": 1
        },
        "is_fallback": {
          "type": "boolean",
          "default": false
        },
        "degraded_state": {
          "type": "boolean",
          "default": false
        },
        "evaluation_summary": {
          "type": "string",
          "minLength": 1
        },
        "primary_lane": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "secondary_lanes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/EvaluationResult/properties/primary_lane/anyOf/0"
          },
          "default": []
        },
        "lane_confidence": {
          "type": "string",
          "enum": [
            "High",
            "Medium",
            "Low"
          ]
        },
        "lane_evidence": {
          "type": "string",
          "default": ""
        },
        "nd_score": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            {
              "type": "null"
            }
          ]
        },
        "nd_friendly_score": {
          "$ref": "#/definitions/EvaluationResult/properties/nd_score"
        },
        "politics_stress_score": {
          "$ref": "#/definitions/EvaluationResult/properties/nd_score"
        },
        "sensory_overload_index": {
          "$ref": "#/definitions/EvaluationResult/properties/nd_score"
        },
        "focus_protection_score": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "building_research_ratio": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            {
              "type": "null"
            }
          ]
        },
        "interaction_load": {
          "$ref": "#/definitions/EvaluationResult/properties/building_research_ratio"
        },
        "strategic_value_score": {
          "$ref": "#/definitions/EvaluationResult/properties/focus_protection_score"
        },
        "career_trajectory": {
          "type": "string",
          "enum": [
            "ADVANCING",
            "LATERAL",
            "DETOUR",
            "UNKNOWN"
          ],
          "default": "UNKNOWN"
        },
        "technical_depth_score": {
          "$ref": "#/definitions/EvaluationResult/properties/focus_protection_score"
        },
        "role_ownership_score": {
          "$ref": "#/definitions/EvaluationResult/properties/focus_protection_score"
        },
        "ambiguity_burden": {
          "$ref": "#/definitions/EvaluationResult/properties/focus_protection_score"
        },
        "meeting_burden": {
          "$ref": "#/definitions/EvaluationResult/properties/focus_protection_score"
        },
        "travel_burden": {
          "$ref": "#/definitions/EvaluationResult/properties/focus_protection_score"
        },
        "on_call_burden": {
          "$ref": "#/definitions/EvaluationResult/properties/focus_protection_score"
        },
        "strengths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "gaps": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "risk_flags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "policy_conflicts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "policy": {
                "type": "string",
                "enum": [
                  "RESIDENCY",
                  "WORK_AUTHORIZATION",
                  "ONSITE",
                  "TRAVEL",
                  "ON_CALL"
                ]
              },
              "candidate_constraint": {
                "type": "string",
                "minLength": 1
              },
              "role_requirement": {
                "type": "string",
                "minLength": 1
              },
              "evidence": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "policy",
              "candidate_constraint",
              "role_requirement",
              "evidence"
            ],
            "additionalProperties": false
          },
          "default": []
        },
        "culture_score_derivation_version": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "culture_evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "signal": {
                "type": "string",
                "enum": [
                  "AUTONOMY",
                  "POLITICS_RISK",
                  "SENSORY_WORKLOAD_RISK",
                  "FOCUS_PROTECTION"
                ]
              },
              "score": {
                "anyOf": [
                  {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 100
                      },
                      {
                        "type": "string",
                        "const": "UNKNOWN"
                      }
                    ]
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null
              },
              "quote": {
                "type": [
                  "string",
                  "null"
                ],
                "default": null
              },
              "score_derivation_version": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "signal"
            ],
            "additionalProperties": false
          },
          "maxItems": 4,
          "default": []
        },
        "rejection_codes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "strategic_value": {
          "type": "string",
          "default": ""
        },
        "recommended_cv_version": {
          "type": "string",
          "default": "None"
        },
        "next_action": {
          "type": "string",
          "enum": [
            "PRIORITY_APPLY",
            "APPLY_AFTER_VERIFICATION",
            "LOW_STRATEGIC_VALUE",
            "REJECTED"
          ]
        },
        "evaluated_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "canonical_job_id",
        "job_version_id",
        "pipeline_run_id",
        "provider",
        "model",
        "evaluation_summary",
        "primary_lane",
        "lane_confidence",
        "nd_score",
        "nd_friendly_score",
        "politics_stress_score",
        "sensory_overload_index",
        "building_research_ratio",
        "interaction_load",
        "next_action",
        "evaluated_at"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}