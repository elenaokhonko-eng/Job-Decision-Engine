# Streamlit Community Cloud Secrets Template
# Copy these key-value pairs into the "Secrets" settings box when deploying on share.streamlit.io

DATABASE_URL = "postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-xxx.neon.tech/neondb?sslmode=require"
# Optional managed API boundary. If omitted, shortlist reads use the read-only
# canonical PostgreSQL model; mutations require this authenticated API URL.
JDEC_API_BASE_URL = "https://api.example.com"
JDEC_API_TOKEN = "YOUR_MANAGED_API_TOKEN"
WORKSPACE_KEY = "default"
WORKSPACE_USER_KEY = "local_user"
GEMINI_API_KEY = "sk-kimi-YOUR_API_KEY"
KIMI_MODEL = "moonshot-v1-8k"
GMAIL_USER = "your.email@gmail.com"
GMAIL_APP_PASSWORD = "your-16-char-app-password"
GMAIL_FOLDER = "Jobs-Alerts"
GMAIL_PROCESSED_FOLDER = "Jobs-Alerts-Processed"
