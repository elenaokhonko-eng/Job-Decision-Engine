[
  {
    "type": "cycle",
    "from": "src/services/agent.ts",
    "to": "src/services/llmFallback.ts",
    "rule": {
      "severity": "error",
      "name": "no-circular"
    },
    "cycle": [
      {
        "name": "src/services/llmFallback.ts",
        "dependencyTypes": [
          "local",
          "import"
        ]
      },
      {
        "name": "src/services/agent.ts",
        "dependencyTypes": [
          "local",
          "import"
        ]
      }
    ]
  },
  {
    "type": "dependency",
    "from": "src/pipeline/laneRouter.ts",
    "to": "src/tasks/pipelineTasks.ts",
    "rule": {
      "severity": "error",
      "name": "pipeline-not-above"
    }
  }
]
